{
  "name": "agent-deploy-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "check:manifest": "tsx scripts/check-manifest.ts",
    "eval": "tsx scripts/eval.ts",
    "dev": "tsx watch src/api/main.ts",
    "start": "tsx src/api/main.ts",
    "cli": "tsx src/cli/main.ts",
    "litellm-ui": "kubectl --context kind-agent-deploy-lab -n llm port-forward svc/litellm 4000:4000",
    "litellm-password": "kubectl --context kind-agent-deploy-lab -n llm get secret litellm -o go-template='{{.data.LITELLM_MASTER_KEY | base64decode}}' && echo"
  },
  "dependencies": {
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "openai": "^7.45.1",
    "prom-client": "^15.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
